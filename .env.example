# Supabase — Phase 8 authentication foundation.
# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API keys).
#
# Never commit real values. Never add the secret key (sb_secret_...) here or to
# any NEXT_PUBLIC_* variable — it must not reach the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
