# Supabase — Phase 8 authentication foundation.
# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API keys).
#
# Never commit real values. Never add the secret key (sb_secret_...) to any
# NEXT_PUBLIC_* variable — that prefix inlines the value into the browser
# bundle.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Phase 9b — server-only. Required to invite an instructor, or to generate or reset an instructor temporary password (Settings →
# Instructors → Provide Login Access), which needs the Supabase Auth Admin
# API. This key bypasses RLS entirely: it is read only by
# lib/supabase/admin.js, which is marked `server-only`, and must never be
# given a NEXT_PUBLIC_ prefix or referenced from client code.

SUPABASE_SECRET_KEY=

# The application's own public address - the origin only (scheme + host, plus a port if it is not the default), no path or trailing
# segments. It is used to build the links in the password-reset email and in the instructor invitation email, so those links can only ever
# point at this application and never at a host taken from a request. Server-only (do NOT give it a NEXT_PUBLIC_ prefix). Required wherever the app runs for real:
#   production / staging:  SITE_URL=https://your-domain.example      (https is required)
#   local development:     optional - when unset under `next dev` it defaults to http://localhost:3000; set it if you use another port,
#                          or if you run `next start` (that is a production build, so it needs it set, e.g. http://localhost:3000)
# If it is missing or not a valid origin, the password-reset form and "Provide Login Access" (the email invitation) show an "unavailable" /
# "not configured" message and send nothing.
# Also add <SITE_URL>/auth/recovery and <SITE_URL>/auth/invite to the redirect-URL allowlist in Supabase Auth -> URL Configuration.
# It cannot be checked from this repository - verify it in the Supabase dashboard.

SITE_URL=
