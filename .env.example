# Supabase — Phase 8 authentication foundation.
# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API keys).
#
# Never commit real values. Never add the secret key (sb_secret_...) to any
# NEXT_PUBLIC_* variable — that prefix inlines the value into the browser
# bundle.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Phase 9b — server-only. Required to invite an instructor (Settings →
# Instructors → Provide Login Access), which needs the Supabase Auth Admin
# API. This key bypasses RLS entirely: it is read only by
# lib/supabase/admin.js, which is marked `server-only`, and must never be
# given a NEXT_PUBLIC_ prefix or referenced from client code.

SUPABASE_SECRET_KEY=
